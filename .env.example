# Copy to .env (never committed): what docker compose and the Makefile read. Secrets, plus where things run.
TICKETS_API_KEY=            # 16+ characters; the agent uses the same value to call tickets
AGENT_API_KEY=              # 16+ characters; what callers of the agent's API send as `Authorization: Bearer ...`

# Optional: another OpenAI-compatible server instead of the host's Ollama (host:port), e.g. host.docker.internal:1234
# LLM_UPSTREAM=host.docker.internal:11434
# Optional: host ports, if the defaults are taken
# QDRANT_PORT=6333
# RAG_PORT=8000
# TICKETS_PORT=8002
# AGENT_PORT=8001
