# Copy to services/agent/.env (never committed). Secrets only: every other setting is in config.yaml (design/4).
# The tickets service's key: the same value as its TICKETS_API_KEY.
AGENT_TICKETS__API_KEY=
# What callers of the agent's API (api.py) must send, at least 16 characters. Not needed by the CLI.
AGENT_API__API_KEY=
